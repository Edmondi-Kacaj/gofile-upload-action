#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

# 1. Run the build command
echo "🚀 Building the GitHub Action..."
npm run build

# 2. Check if the 'dist' folder has changed
if [ -n "$(git status --porcelain dist)" ]; then
  echo "📦 Changes detected in dist/. Committing updated build..."
  
  # Stage the dist folder
  git add dist
  
  # Commit the changes (using --no-verify to prevent any infinite loops)
  git commit -m "build: auto-update dist/ before push [skip ci]" --no-verify
  
  # Adjust the push command to include the new local commit seamlessly
  exec git push origin HEAD --no-verify
else
  echo "✅ dist/ is already up to date."
fi
